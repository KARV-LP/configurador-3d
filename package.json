{
  "name": "@karv/configurador-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run validate:contracts && vitest run",
    "e2e": "playwright test",
    "e2e:live": "node scripts/run-live-e2e.mjs",
    "guard": "node scripts/guard.mjs",
    "audit": "npm audit --audit-level=moderate",
    "budget": "node scripts/check-budgets.mjs",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "ci": "npm run format:check && npm run lint && npm run guard && npm run audit && npm test && npm run build && npm run budget && npm run e2e"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "@netlify/blobs": "^11.1.6",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "^8.3.4",
    "vitest": "4.1.12"
  }
}
