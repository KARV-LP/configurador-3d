{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.k-arv.com/configurador-3d/f11/proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 1
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "karv-chair"
        },
        "version": {
          "const": 2
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "version", "sha256"]
    },
    "validation_status": {
      "enum": ["draft", "approved", "rejected"]
    },
    "revestimentos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "https://schemas.k-arv.com/configurador-3d/f11/custom-revestimento.schema.json"
      }
    },
    "public_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": ["title"]
    }
  },
  "required": [
    "contract_version",
    "proposal_id",
    "geometry",
    "validation_status",
    "revestimentos",
    "public_metadata"
  ]
}
