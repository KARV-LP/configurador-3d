{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.k-arv.com/configurador-3d/v1/material.schema.json",
  "title": "KARV Public Material",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "material_id",
    "name",
    "taxonomy",
    "publication",
    "compatibility",
    "preview",
    "physical",
    "pbr"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "material_id": { "$ref": "#/$defs/materialId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "material_type", "color_family", "collection", "functional_features"],
      "properties": {
        "kind": { "enum": ["technical-fabric", "karv-design"] },
        "material_type": { "type": "string", "minLength": 1 },
        "color_family": { "type": "string", "minLength": 1 },
        "collection": { "type": "string", "minLength": 1 },
        "functional_features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "configurator_enabled"],
      "properties": {
        "status": { "enum": ["draft", "published", "retired"] },
        "configurator_enabled": { "type": "boolean" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry_ids"],
      "properties": {
        "geometry_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalId" }
        }
      }
    },
    "preview": { "$ref": "#/$defs/imageAsset" },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeat_width_mm", "repeat_height_mm", "grain_direction"],
      "properties": {
        "repeat_width_mm": { "type": "number", "exclusiveMinimum": 0 },
        "repeat_height_mm": { "type": "number", "exclusiveMinimum": 0 },
        "grain_direction": { "enum": ["warp-v", "warp-u", "non-directional"] }
      }
    },
    "pbr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "base_color", "roughness", "metalness"],
      "properties": {
        "status": { "enum": ["preview", "production"] },
        "base_color": { "$ref": "#/$defs/imageAsset" },
        "normal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset", "convention", "strength"],
          "properties": {
            "asset": { "$ref": "#/$defs/imageAsset" },
            "convention": { "const": "opengl" },
            "strength": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        "ambient_occlusion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset", "strength"],
          "properties": {
            "asset": { "$ref": "#/$defs/imageAsset" },
            "strength": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "roughness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["factor"],
          "properties": {
            "factor": { "type": "number", "minimum": 0, "maximum": 1 },
            "asset": { "$ref": "#/$defs/imageAsset" }
          }
        },
        "metalness": { "const": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "production" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "normal": {},
              "ambient_occlusion": {}
            },
            "required": ["normal", "ambient_occlusion"]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication": {
            "type": "object",
            "properties": { "configurator_enabled": { "const": true } },
            "required": ["configurator_enabled"]
          }
        },
        "required": ["publication"]
      },
      "then": {
        "properties": {
          "publication": {
            "type": "object",
            "properties": { "status": { "const": "published" } }
          },
          "pbr": {
            "type": "object",
            "properties": { "status": { "const": "production" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "materialId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "imageAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "media_type", "sha256"],
      "properties": {
        "uri": { "type": "string", "format": "uri-reference" },
        "media_type": { "enum": ["image/webp", "image/png", "image/jpeg"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
