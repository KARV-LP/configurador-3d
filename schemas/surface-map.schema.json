{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.k-arv.com/configurador-3d/v1/surface-map.schema.json",
  "title": "KARV Surface Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "geometry", "camera", "surfaces"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256", "asset"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "version": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "asset": { "type": "string", "pattern": "\\.glb$" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_m", "default_orbit", "limits", "field_of_view_deg", "zoom_enabled", "auto_rotate"],
      "properties": {
        "target_m": { "$ref": "#/$defs/vector3" },
        "default_orbit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["azimuth_deg", "polar_deg", "radius_m"],
          "properties": {
            "azimuth_deg": { "type": "number" },
            "polar_deg": { "type": "number", "minimum": 0, "maximum": 180 },
            "radius_m": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_azimuth_deg", "max_azimuth_deg", "min_polar_deg", "max_polar_deg", "min_radius_m", "max_radius_m"],
          "properties": {
            "min_azimuth_deg": { "type": "number" },
            "max_azimuth_deg": { "type": "number" },
            "min_polar_deg": { "type": "number", "minimum": 0, "maximum": 180 },
            "max_polar_deg": { "type": "number", "minimum": 0, "maximum": 180 },
            "min_radius_m": { "type": "number", "exclusiveMinimum": 0 },
            "max_radius_m": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "field_of_view_deg": { "type": "number", "minimum": 10, "maximum": 60 },
        "zoom_enabled": { "type": "boolean" },
        "auto_rotate": { "type": "boolean" }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mesh_name", "material_name", "primitive_index", "requires_material_instance"],
      "properties": {
        "mesh_name": { "type": "string", "minLength": 1 },
        "material_name": { "type": "string", "minLength": 1 },
        "primitive_index": { "type": "integer", "minimum": 0 },
        "requires_material_instance": { "type": "boolean" }
      }
    },
    "textureFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uv_set", "uv_name", "rotation_degrees", "flip_u", "flip_v", "meters_per_uv_unit", "calibration_method", "calibration_status"],
      "properties": {
        "uv_set": { "type": "integer", "minimum": 0 },
        "uv_name": { "type": "string", "minLength": 1 },
        "rotation_degrees": { "enum": [0, 90, 180, 270] },
        "flip_u": { "type": "boolean" },
        "flip_v": { "type": "boolean" },
        "meters_per_uv_unit": { "type": "number", "exclusiveMinimum": 0 },
        "calibration_method": { "enum": ["area-ratio", "manual"] },
        "calibration_status": { "enum": ["derived", "visual-approved"] }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "public_name", "public_group", "classification", "binding"],
      "properties": {
        "surface_id": { "$ref": "#/$defs/canonicalId" },
        "public_name": { "type": "string", "minLength": 1 },
        "public_group": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["configurable", "fixed"] },
        "binding": { "$ref": "#/$defs/binding" },
        "texture_frame": { "$ref": "#/$defs/textureFrame" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "classification": { "const": "configurable" } },
            "required": ["classification"]
          },
          "then": {
            "properties": { "texture_frame": { "$ref": "#/$defs/textureFrame" } },
            "required": ["texture_frame"]
          },
          "else": {
            "properties": { "texture_frame": false }
          }
        }
      ]
    }
  }
}
