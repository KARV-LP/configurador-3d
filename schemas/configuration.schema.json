{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.k-arv.com/configurador-3d/v1/configuration.schema.json",
  "title": "KARV Chair Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "geometry", "assignments"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "configuration_id": { "type": "string", "format": "uuid" },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "version": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "assignments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/canonicalId" },
      "additionalProperties": { "$ref": "#/$defs/materialId" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "materialId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
